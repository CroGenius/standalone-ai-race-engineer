                        <TextBlock Text="Current trend" /><TextBlock Text="{Binding DriverCoachingTrendLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Biggest weakness" /><TextBlock Text="{Binding DriverCoachingBiggestWeaknessLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Strongest area" /><TextBlock Text="{Binding DriverCoachingStrongestAreaLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Consistency" /><TextBlock Text="{Binding DriverCoachingConsistencyLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Previous session delta" /><TextBlock Text="{Binding DriverCoachingPreviousDeltaLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </UniformGrid>
                    <TextBlock Text="Top 3 targets" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding DriverCoachingTopTargetsLabel}" TextWrapping="Wrap" Foreground="#9AA6AC" Margin="0,0,0,18" />

                    <TextBlock Text="Session Memory / Debrief" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="2" Rows="3" Margin="0,0,0,8">
                        <TextBlock Text="Last stored summary" /><TextBlock Text="{Binding SessionMemoryLastSummaryLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Previous best lap" /><TextBlock Text="{Binding RaceMemoryPreviousBestLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Previous avg lap" /><TextBlock Text="{Binding RaceMemoryPreviousAverageLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </UniformGrid>
                    <TextBlock Text="Known weaknesses" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding SessionMemoryKnownWeaknessesLabel}" TextWrapping="Wrap" Foreground="#9AA6AC" Margin="0,0,0,8" />
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="Generate Debrief" Command="{Binding GenerateDebriefCommand}" Margin="0,0,4,0" Padding="10,6" />
                        <Button Content="Save Memory Summary" Command="{Binding SaveMemorySummaryCommand}" Margin="4,0,0,0" Padding="10,6" />
                    </UniformGrid>
                    <TextBlock Text="Debrief preview" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding SessionDebriefPreview}" TextWrapping="Wrap" Foreground="#9AA6AC" Margin="0,0,0,18" />

                    <TextBlock Text="{Binding PerformancePanelTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="2" Rows="7" Margin="0,0,0,18">
                        <TextBlock Text="Biggest time loss" /><TextBlock Text="{Binding PerformanceBiggestLossLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Main weakness" /><TextBlock Text="{Binding PerformanceMainWeaknessLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Braking quality" /><TextBlock Text="{Binding PerformanceBrakingQualityLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Throttle quality" /><TextBlock Text="{Binding PerformanceThrottleQualityLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Consistency" /><TextBlock Text="{Binding PerformanceConsistencyLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Current vs best" /><TextBlock Text="{Binding PerformanceCurrentVsBestLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Stored baseline" /><TextBlock Text="{Binding PerformanceStoredBaselineLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </UniformGrid>

                    <TextBlock Text="{Binding AnalyticsPanelTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="2" Rows="8" Margin="0,0,0,18">
                        <TextBlock Text="Lap consistency" /><TextBlock Text="{Binding AnalyticsLapConsistency}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Fuel trend" /><TextBlock Text="{Binding AnalyticsFuelTrend}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Brake stability" /><TextBlock Text="{Binding AnalyticsBrakeStability}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Throttle smoothness" /><TextBlock Text="{Binding AnalyticsThrottleSmoothness}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Pace trend" /><TextBlock Text="{Binding AnalyticsPaceTrend}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Incidents" /><TextBlock Text="{Binding AnalyticsIncidents}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Best vs average" /><TextBlock Text="{Binding AnalyticsBestVsAverage}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Driver profile" /><TextBlock Text="{Binding AnalyticsDriverProfile}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </UniformGrid>

                    <TextBlock Text="{Binding StrategyPanelTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="2" Rows="4" Margin="0,0,0,8">
                        <TextBlock Text="Fuel risk" /><TextBlock Text="{Binding StrategyFuelRisk}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Laps remaining" /><TextBlock Text="{Binding StrategyLapsRemaining}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Pit recommendation" /><TextBlock Text="{Binding StrategyPitRecommendation}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Tyre risk" /><TextBlock Text="{Binding StrategyTyreRisk}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </UniformGrid>
                    <TextBlock Text="Strategy summary" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding StrategySummary}" TextWrapping="Wrap" Foreground="#9AA6AC" Margin="0,0,0,8" />
                    <TextBlock Text="Strategy Knowledge" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <UniformGrid Columns="2" Rows="5" Margin="0,0,0,18">
                        <TextBlock Text="Track" /><TextBlock Text="{Binding StrategyKnowledgeTrackLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Car / class" /><TextBlock Text="{Binding StrategyKnowledgeCarClassLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Recommended fuel" /><TextBlock Text="{Binding StrategyKnowledgeRecommendedFuelLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Confidence" /><TextBlock Text="{Binding StrategyKnowledgeConfidenceLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Data source" /><TextBlock Text="{Binding StrategyKnowledgeSourceLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </UniformGrid>

                    <TextBlock Text="Track Intelligence" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <UniformGrid Columns="2" Rows="7" Margin="0,0,0,18">
                        <TextBlock Text="Track" /><TextBlock Text="{Binding TrackIntelligenceTrackLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Car class" /><TextBlock Text="{Binding TrackIntelligenceCarClassLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Brake demand" /><TextBlock Text="{Binding TrackIntelligenceBrakeDemandLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Tyre demand" /><TextBlock Text="{Binding TrackIntelligenceTyreDemandLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Fuel expectation" /><TextBlock Text="{Binding TrackIntelligenceFuelExpectationLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Setup focus" /><TextBlock Text="{Binding TrackIntelligenceSetupFocusLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Overtaking zones" /><TextBlock Text="{Binding TrackIntelligenceOvertakingZonesLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </UniformGrid>

                    <TextBlock Text="{Binding LapIntelligenceTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="2" Rows="6" Margin="0,0,0,18">
                        <TextBlock Text="Best lap" /><TextBlock Text="{Binding LapIntelligenceBestLap}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Theoretical best" /><TextBlock Text="{Binding LapIntelligenceTheoreticalBest}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Pace trend" /><TextBlock Text="{Binding LapIntelligencePaceTrend}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Sector gain/loss" /><TextBlock Text="{Binding LapIntelligenceSectorGainLoss}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Strengths" /><TextBlock Text="{Binding LapIntelligenceStrengths}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Weaknesses" /><TextBlock Text="{Binding LapIntelligenceWeaknesses}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </UniformGrid>

                    <TextBlock Text="{Binding TyreIntelligenceTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="2" Rows="4" Margin="0,0,0,18">
                        <TextBlock Text="Grip confidence" /><TextBlock Text="{Binding TyreGripConfidence}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Warmup state" /><TextBlock Text="{Binding TyreWarmupState}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Tyre readiness" /><TextBlock Text="{Binding TyreReadiness}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Overheating risk" /><TextBlock Text="{Binding TyreOverheatingRisk}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </UniformGrid>

                    <TextBlock Text="Race Prep" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="2">
                        <TextBlock Text="Car" /><TextBox Text="{Binding PrepCar, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Track" /><TextBox Text="{Binding PrepTrack, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Session type" /><TextBox Text="{Binding PrepSessionType, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Target stint" /><TextBox Text="{Binding PrepTargetStintLength, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Fuel plan" /><TextBox Text="{Binding PrepFuelPlan, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Tyre plan" /><TextBox Text="{Binding PrepTyrePlan, UpdateSourceTrigger=PropertyChanged}" />
                    </UniformGrid>
                    <TextBlock Text="Practice goal" Margin="0,8,0,2" /><TextBox Text="{Binding PrepPracticeGoal, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Driver reminders" Margin="0,8,0,2" /><TextBox Text="{Binding PrepDriverReminders, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="44" TextWrapping="Wrap" />
                    <TextBlock Text="Setup notes" Margin="0,8,0,2" /><TextBox Text="{Binding PrepSetupNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="44" TextWrapping="Wrap" />
                    <TextBlock Text="Strategy notes" Margin="0,8,0,2" /><TextBox Text="{Binding PrepStrategyNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="44" TextWrapping="Wrap" />
                    <UniformGrid Columns="2" Margin="0,10,0,18">
                        <Button Content="Save Prep" Command="{Binding SavePrepCommand}" />
                        <Button Content="Load Prep" Command="{Binding LoadPrepCommand}" />
                    </UniformGrid>
                    <TextBlock Text="Track Guide" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="2" Rows="4" Margin="0,0,0,8">
                        <TextBlock Text="Detected track" /><TextBlock Text="{Binding TrackResearchDetectedTrackLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Guide available" /><TextBlock Text="{Binding TrackGuideAvailableLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Last update" /><TextBlock Text="{Binding TrackGuideLastFetchedLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                        <TextBlock Text="Source count" /><TextBlock Text="{Binding TrackGuideSourceCountLabel}" TextAlignment="Right" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </UniformGrid>
                    <Button Content="Refresh Guide"
                            Command="{Binding FetchTrackGuideCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="10,6"
                            Margin="0,0,0,8" />
                    <TextBlock Text="Braking zones" Margin="0,0,0,2" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TrackGuideBrakingZonesLabel}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="Traction zones" Margin="0,0,0,2" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TrackGuideTractionZonesLabel}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="Key corners" Margin="0,0,0,2" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TrackGuideKeyCornersLabel}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="Setup notes" Margin="0,0,0,2" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TrackGuideSetupNotesLabel}" TextWrapping="Wrap" Margin="0,0,0,18" />
                    <TextBlock Text="Research" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ResearchLabel" />
                            <ColumnDefinition Width="*" MinWidth="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Detected track" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WebResearchDetectedTrackLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Detected car/class" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WebResearchDetectedCarClassLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Research available" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WebResearchAvailableLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Last fetched" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WebResearchLastFetchedLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Source count" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WebResearchSourceCountLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Provider" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding WebResearchProviderLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Cache" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding WebResearchCacheStatusLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Items fetched" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding WebResearchItemsFetchedLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Fetch status" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding WebResearchFetchStatusLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Last fetch result" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding WebResearchLastFetchResultLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Error" Margin="0,0,12,0" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding WebResearchErrorMessageLabel}" Foreground="#9AA6AC" TextWrapping="Wrap" />
                    </Grid>
                    <UniformGrid Columns="1" Margin="0,0,0,18">
                        <Button Content="Fetch Track Research"
                                Command="{Binding FetchTrackResearchCommand}"
                                HorizontalAlignment="Stretch"
                                Padding="10,6"
                                Margin="0,0,0,6" />
                        <Button Content="Fetch Track+Car Strategy"
                                Command="{Binding FetchTrackCarStrategyResearchCommand}"
                                HorizontalAlignment="Stretch"
                                Padding="10,6"
                                Margin="0,0,0,6" />
                        <Button Content="Refresh Research"
                                Command="{Binding RefreshWebResearchCommand}"
                                HorizontalAlignment="Stretch"
                                Padding="10,6" />
                    </UniformGrid>
                    <TextBlock Text="Track Knowledge" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="2">
                        <TextBlock Text="Title" /><TextBox Text="{Binding KnowledgeTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Category" /><TextBox Text="{Binding KnowledgeCategory, UpdateSourceTrigger=PropertyChanged}" />
                    </UniformGrid>
                    <TextBlock Text="Reliability note" Margin="0,8,0,2" /><TextBox Text="{Binding KnowledgeConfidence, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Content" Margin="0,8,0,2" /><TextBox Text="{Binding KnowledgeContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />
                    <UniformGrid Columns="3" Margin="0,10,0,10">
                        <Button Content="Save Note" Command="{Binding SaveKnowledgeCommand}" />
                        <Button Content="Import File" Command="{Binding ImportKnowledgeCommand}" />
                        <Button Content="Delete" Command="{Binding DeleteKnowledgeCommand}" />
                    </UniformGrid>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchKnowledgeCommand}" />
                        <TextBox Text="{Binding KnowledgeSearch, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding KnowledgeSources}" SelectedItem="{Binding SelectedKnowledgeSource}" DisplayMemberPath="Display" MinHeight="90" MaxHeight="130" Background="#15191D" Foreground="#EFF3F4" BorderBrush="#30383E" Margin="0,0,0,18" />

                    <TextBlock Text="Post-Session Summary" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding SessionSummary}" TextWrapping="Wrap" Foreground="#9AA6AC" />
                    <TextBox Text="{Binding PostSessionNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Button Content="Save Post Note" Command="{Binding SavePostSessionNoteCommand}" HorizontalAlignment="Right" Margin="0,10,0,18" />

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Session Browser" FontSize="17" FontWeight="SemiBold" />
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshSessionsCommand}" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Display" MinHeight="120" MaxHeight="180" Background="#15191D" Foreground="#EFF3F4" BorderBrush="#30383E" />
                    <UniformGrid Columns="2" Margin="0,10,0,10">
                        <Button Content="Review Session" Command="{Binding LoadSelectedSessionCommand}" />
                        <Button Content="Exit Review" Command="{Binding ExitReviewModeCommand}" />
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button Content="Export JSON" Command="{Binding ExportSessionJsonCommand}" />
                        <Button Content="Export MD" Command="{Binding ExportCoachingMarkdownCommand}" />
                    </UniformGrid>
                    <TextBlock Text="{Binding LoadedSessionSummary}" TextWrapping="Wrap" Foreground="#9AA6AC" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
